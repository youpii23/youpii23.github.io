import requests
import json
import time

def search_lcl_leaks():
    # 1. Définition de la requête GitHub
    # On cherche les dépôts contenant "LCL" ou "Credit Lyonnais"
    query = "LCL OR \"Crédit Lyonnais\" language:plaintext OR language:csv"
    url = f"https://api.github.com/search/code?q={query}&per_page=10"
    
    headers = {
        "Accept": "application/vnd.github.v3+json",
        "User-Agent": "LCL-OSINT-Scanner/1.0"
    }

    print(f"Recherche de fuites GitHub pour : {query}")
    
    try:
        response = requests.get(url, headers=headers)
        if response.status_code == 200:
            data = response.json()
            items = data.get('items', [])
            
            if not items:
                print("Aucun résultat direct trouvé. Essayons avec les repositories.")
                search_lcl_repos()
                return

            print(f"{len(items)} fichiers trouvés. Voici les plus prometteurs (fichiers CSV/TXT) :")
            
            # Filtre pour ne garder que les fichiers pertinents
            relevant_files = [item for item in items if item['name'].endswith(('.csv', '.txt', '.json', '.zip'))]
            
            for file in relevant_files[:5]: # On montre les 5 premiers
                print(f"- {file['repository']['full_name']}: {file['path']}")
                # Note: Pour télécharger vraiment, il faut utiliser l'URL du blob ou du raw
                # print(f"  URL Raw: {file['html_url']}")
                
        else:
            print(f"Erreur API GitHub: {response.status_code}")
            
    except Exception as e:
        print(f"Une erreur est survenue: {e}")

def search_lcl_repos():
    # Si les fichiers ne sont pas indexés individuellement, on cherche les repos entiers
    query = "LCL OR \"Credit Lyonnais\""
    url = f"https://api.github.com/search/repositories?q={query}&sort=stars&order=desc&per_page=5"
    headers = {"Accept": "application/vnd.github.v3+json", "User-Agent": "LCL-OSINT-Scanner/1.0"}
    
    response = requests.get(url, headers=headers)
    if response.status_code == 200:
        repos = response.json().get('items', [])
        print("Dépôts populaires contenant 'LCL' :")
        for repo in repos:
            print(f"- {repo['full_name']} ({repo['stargazers_count']} stars)")
            print(f"  URL: {repo['html_url']}")
            print("  -> Va sur ce repo et cherche les fichiers 'assets' ou 'data'")

if __name__ == "__main__":
    search_lcl_leaks()
